{
  "schemaVersion": 1,
  "id": "menearmenear.easytimer",
  "name": "EasyTimer",
  "version": "2.0.0",
  "author": "menearmenear",
  "license": "MIT",
  "description": "A simple, fully customizable countdown timer for the Omarchy top bar",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "EasyTimer",
    "description": "One timer with an editable duration, customizable bar display, sound and notifications",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "centerEnd",
    "defaults": {
      "minutes": 25,
      "sound": true,
      "soundVolume": 70,
      "notifications": true,
      "showIcon": true,
      "glyph": "󰔟",
      "glyphPaused": "󰏤",
      "showLabel": false,
      "label": "TIMER",
      "barFormat": "countdown",
      "timeFormat": "auto",
      "color": "",
      "doneColor": ""
    },
    "schema": [
      {
        "key": "minutes",
        "type": "number",
        "label": "Timer length (minutes)",
        "description": "1-1440 (24 hours)"
      },
      {
        "key": "sound",
        "type": "boolean",
        "label": "Chime when the timer ends"
      },
      {
        "key": "soundVolume",
        "type": "number",
        "label": "Chime volume (0-100)"
      },
      {
        "key": "notifications",
        "type": "boolean",
        "label": "Desktop notification when the timer ends"
      },
      {
        "key": "showIcon",
        "type": "boolean",
        "label": "Show an icon in the bar"
      },
      {
        "key": "glyph",
        "type": "string",
        "label": "Timer icon glyph",
        "description": "Nerd Font glyph shown while running"
      },
      {
        "key": "glyphPaused",
        "type": "string",
        "label": "Paused icon glyph",
        "description": "Nerd Font glyph shown while paused"
      },
      {
        "key": "showLabel",
        "type": "boolean",
        "label": "Show a text label in the bar"
      },
      {
        "key": "label",
        "type": "string",
        "label": "Bar label",
        "description": "Shown with countdown-label / label formats"
      },
      {
        "key": "barFormat",
        "type": "string",
        "label": "Bar format",
        "description": "countdown | countdown-label | percent | label | icon"
      },
      {
        "key": "timeFormat",
        "type": "string",
        "label": "Time format",
        "description": "auto | always | never (show hours)"
      },
      {
        "key": "color",
        "type": "string",
        "label": "Timer color",
        "description": "Hex color such as #a6adc8, blank follows the theme"
      },
      {
        "key": "doneColor",
        "type": "string",
        "label": "Finished color",
        "description": "Hex color when the timer finishes, blank follows the theme"
      }
    ]
  }
}
