{
  "schemaVersion": 1,
  "id": "menearmenear.easytimer",
  "name": "EasyTimer",
  "version": "1.0.0",
  "author": "menearmenear",
  "license": "MIT",
  "description": "A fully customizable countdown and focus timer for the Omarchy top bar",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "EasyTimer",
    "description": "Countdown / focus timer with a customizable bar label, durations, sounds and notifications",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "centerEnd",
    "defaults": {
      "focusMinutes": 25,
      "breakMinutes": 5,
      "longBreakMinutes": 15,
      "roundsBeforeLongBreak": 4,
      "autoStartBreaks": true,
      "autoStartFocus": false,
      "sound": true,
      "soundVolume": 70,
      "notifications": true,
      "showIcon": true,
      "iconFocus": "󰔟",
      "iconBreak": "󰅶",
      "iconPaused": "󰏤",
      "showLabel": false,
      "label": "TIMER",
      "labelOnBreak": "BREAK",
      "barFormat": "countdown",
      "timeFormat": "auto",
      "focusColor": "",
      "breakColor": "",
      "doneColor": ""
    },
    "schema": [
      {
        "key": "focusMinutes",
        "type": "number",
        "label": "Focus length (minutes)",
        "description": "1-180"
      },
      {
        "key": "breakMinutes",
        "type": "number",
        "label": "Short break length (minutes)",
        "description": "1-60"
      },
      {
        "key": "longBreakMinutes",
        "type": "number",
        "label": "Long break length (minutes)",
        "description": "1-120"
      },
      {
        "key": "roundsBeforeLongBreak",
        "type": "number",
        "label": "Rounds before a long break",
        "description": "2-12"
      },
      {
        "key": "autoStartBreaks",
        "type": "boolean",
        "label": "Auto-start breaks"
      },
      {
        "key": "autoStartFocus",
        "type": "boolean",
        "label": "Auto-start the next focus round"
      },
      {
        "key": "sound",
        "type": "boolean",
        "label": "Chime when a phase ends"
      },
      {
        "key": "soundVolume",
        "type": "number",
        "label": "Chime volume (0-100)"
      },
      {
        "key": "notifications",
        "type": "boolean",
        "label": "Desktop notification when a phase ends"
      },
      {
        "key": "showIcon",
        "type": "boolean",
        "label": "Show an icon in the bar"
      },
      {
        "key": "iconFocus",
        "type": "string",
        "label": "Focus icon glyph",
        "description": "Nerd Font glyph used during focus"
      },
      {
        "key": "iconBreak",
        "type": "string",
        "label": "Break icon glyph",
        "description": "Nerd Font glyph used during breaks"
      },
      {
        "key": "iconPaused",
        "type": "string",
        "label": "Paused icon glyph",
        "description": "Nerd Font glyph used while paused"
      },
      {
        "key": "showLabel",
        "type": "boolean",
        "label": "Show a text label in the bar"
      },
      {
        "key": "label",
        "type": "string",
        "label": "Focus label",
        "description": "Shown with countdown / percent formats"
      },
      {
        "key": "labelOnBreak",
        "type": "string",
        "label": "Break label",
        "description": "Shown with countdown / percent formats"
      },
      {
        "key": "barFormat",
        "type": "string",
        "label": "Bar format",
        "description": "countdown | countdown-label | percent | label | icon"
      },
      {
        "key": "timeFormat",
        "type": "string",
        "label": "Time format",
        "description": "auto | always | never (show hours)"
      },
      {
        "key": "focusColor",
        "type": "string",
        "label": "Focus color",
        "description": "Hex color such as #a6adc8, blank follows the theme"
      },
      {
        "key": "breakColor",
        "type": "string",
        "label": "Break color",
        "description": "Hex color, blank follows the theme"
      },
      {
        "key": "doneColor",
        "type": "string",
        "label": "Ready color",
        "description": "Hex color for a finished phase, blank follows the theme"
      }
    ]
  }
}
